<TitlePage>
  <Content>
    <Paragraph Type="Title"><Text>Matadero</Text></Paragraph>
    <Paragraph Type="Credit"><Text>Escrito por</Text></Paragraph>
    <Paragraph Type="Author"><Text>Mariano Borgognone</Text></Paragraph>
    <Paragraph Type="Author"><Text>Isabela Gonzalez Fazo</Text></Paragraph>
