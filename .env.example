# =============================================================================
# Bestscreen environment cheat-sheet
#
# This file is a REFERENCE only — Bestscreen has no build step, so the browser
# cannot read `.env` directly. The actual loadable config file is
# `config.local.js`, generated from `config.example.js`. Use this `.env` to
# keep all your secrets in one place; copy the values into `config.local.js`.
#
# Steps:
#   1. cp .env.example .env                  # then fill in your keys here
#   2. cp config.example.js config.local.js  # then paste the keys there too
#
# Both .env and config.local.js are gitignored.
# =============================================================================

# -------- AI providers ----------------------------------------------------
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional Anthropic model override (defaults to claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI API key (optional — only needed if you switch the provider).
OPENAI_API_KEY=
# Optional OpenAI model override (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Which provider to use by default. "anthropic" or "openai".
AI_PROVIDER=anthropic

# -------- Firebase (currently NOT used at runtime) ------------------------
# Bestscreen uses Firebase Hosting only — `firebase deploy` handles auth via
# `firebase login`, no client-side SDK is loaded. These keys are placeholders
# in case you wire Firestore (cross-device sync) or Firebase Auth later.
# Find them in the Firebase Console → Project settings → General → Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=wr-ai-ters-room.firebaseapp.com
FIREBASE_PROJECT_ID=wr-ai-ters-room
FIREBASE_STORAGE_BUCKET=wr-ai-ters-room.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -------- Optional ---------------------------------------------------------
# Author name to stamp on PDF watermarks and change-log entries.
AUTHOR_NAME=
