{
  "name": "bestscreen",
  "version": "1.0.0",
  "private": true,
  "description": "A screenwriting power tool. Single-page, local-first. No build step.",
  "scripts": {
    "dev": "node dev-server.js",
    "start": "node dev-server.js",
    "open": "node dev-server.js --open",
    "test": "vitest run --exclude='**/format-verify.spec.js' --exclude='**/audit-capture.mjs'",
    "test:watch": "vitest --exclude='**/format-verify.spec.js' --exclude='**/audit-capture.mjs'"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vitest": "^3.2.1"
  }
}
